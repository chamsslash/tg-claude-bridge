# --- конфиг моста ---------------------------------------------------------
# Скопируй в .env и заполни. .env в git не попадает (см. .gitignore), а
# репозиторий публичный — живых значений здесь быть не должно.
# Токен Claude лежит НЕ здесь, а в claude.env: в контейнер claude этот файл
# не попадает, и наоборот.

# Бот Telegram (@BotFather).
TELEGRAM_BOT_TOKEN=

# Google: Gmail (только чтение) и Календарь. Desktop-клиент OAuth из Google
# Cloud Console; refresh-токен даёт `go run ./cmd/tg-bridge google-auth` на
# ноутбуке — см. README. Все три или ни одного.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Yazio: почта и пароль входа (пароль задаётся в приложении через «Забыли
# пароль?», если входил через Google). Оба или ни одного.
YAZIO_USERNAME=
YAZIO_PASSWORD=

# Необязательное.
# YAZIO_USER_AGENT=YAZIO/26.30.1 (com.yazio.ios.YAZIO; build:2607271240; iOS 27.0.0) Ktor
# TELEGRAM_CHAT_ID=1494256272
# GMAIL_POLL_INTERVAL=1h
# LLM_PER_HOUR=40
# CLAUDE_TIMEOUT=5m
# REQUEST_TIMEOUT=1m
# POLL_TIMEOUT=50s
# Куда пускать контейнер claude; по умолчанию *:443 (веб для еды). Только
# Anthropic: api.anthropic.com:443,platform.claude.com:443
# EGRESS_ALLOW=*:443
# STATE_PATH=/data/state.json
