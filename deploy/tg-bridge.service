[Unit]
Description=Мост Telegram -> облачная рутина Claude
After=network-online.target
Wants=network-online.target
# Длинный опрос рвётся при каждом обрыве связи, и перезапуск здесь — штатное
# событие, а не повод уйти в failed. Ключ живёт именно в [Unit]: в [Service]
# systemd его молча игнорирует.
StartLimitIntervalSec=0

[Service]
Type=simple
# Сервис живёт в каталоге проектов на примонтированном диске: корневой раздел
# маленький, и все остальные проекты машины лежат там же.
WorkingDirectory=/mnt/data/projects/tg-claude-bridge
ExecStart=/mnt/data/projects/tg-claude-bridge/bin/tg-bridge
Environment=STATE_PATH=/mnt/data/projects/tg-claude-bridge/state/offset.json
# Секреты читает systemd, а не процесс: так токены не попадают ни в командную
# строку, ни в список процессов.
EnvironmentFile=/mnt/data/projects/tg-claude-bridge/.env

# Фиксированный пользователь вместо DynamicUser: состояние лежит рядом с
# проектом, а не в /var/lib, и владелец у файлов должен быть постоянным —
# динамический uid меняется от запуска к запуску и терял бы к ним доступ.
User=gyattalert
Group=gyattalert

Restart=always
RestartSec=5

# Мосту нужна только исходящая сеть и свой каталог состояния.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/data/projects/tg-claude-bridge/state
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
