# Скопируй в claude.env. Этот файл получает только контейнер claude.
#
# Долгоживущий токен подписки Claude: `claude setup-token` на машине, где
# Claude Code залогинен в твой аккаунт (живёт около года).
CLAUDE_CODE_OAUTH_TOKEN=

# Модель; пусто — по умолчанию CLI.
# CLAUDE_MODEL=sonnet
# RUN_TIMEOUT=3m
